generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Roles {
  Gerente
  Auxiliar
  Junior
  Pleno
  Senior
}

enum TicketStatus {
  Open
  Closed
  Progress
}

model Companies {
  id    Int    @id @default(autoincrement())
  name  String @db.VarChar(45)
  email String @unique @db.VarChar(45)
  cnpj  String @unique @db.VarChar(45)

  departments Departments[]
  users       User[]
}

model Departments {
  id          Int    @id @default(autoincrement())
  name        String @db.VarChar(25)
  description String @db.VarChar(80)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  users   User[]
  tickets Ticket[]
}

model Users {
  id       Int    @id @default(autoincrement())
  name     String @db.VarChar(45)
  email    String @unique @db.VarChar(45)
  password String @db.VarChar(60)
  role     Role

  departmentId Int
  companyId    Int

  department Department @relation(fields: [departmentId], references: [id])
  company    Company    @relation(fields: [companyId], references: [id])

  ownedTickets Ticket[] @relation("TicketOwner")
  comments     Comment[]
  assignments  TicketAssignment[]
}

model Tickets {
  id          Int    @id @default(autoincrement())
  title       String @db.VarChar(25)
  description String @db.VarChar(80)

  status TicketStatus

  opening    DateTime  @db.Date
  completion DateTime? @db.Date

  departmentId Int
  ownerId      Int

  department Department @relation(fields: [departmentId], references: [id])
  owner      User       @relation("TicketOwner", fields: [ownerId], references: [id])

  comments  Comment[]
  assignees TicketAssignment[]
}

model TicketAssignment {
  ticketId Int
  userId   Int

  ticket Ticket @relation(fields: [ticketId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@id([ticketId, userId])
}

model Comments {
  id          Int     @id @default(autoincrement())
  description String? @db.VarChar(80)

  ticketId Int
  userId   Int

  ticket Ticket @relation(fields: [ticketId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}